# Base de contenidos SQLite (opcional; por defecto backend/data/oposiciones.sqlite3)
OPOCOACH_DB_PATH=

# Supabase PostgreSQL - Session/Shared pooler.
# NO subas backend/.env a Git.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[HOST-POOLER]:5432/postgres


# Project URL, por ejemplo https://xxxxxxxx.supabase.co
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Clave pública del proyecto (publishable key). Puede exponerse al frontend.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...


# Stripe SANDBOX / TEST
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
FRONTEND_URL=http://localhost:3000

# Se obtiene al ejecutar: stripe listen --forward-to http://127.0.0.1:8000/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
